# RouteWise simulator / real-evaluation environment template.
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`.
#
#   cp .env.example .env
#
# Only the providers you actually exercise need keys. Everything under
# "Observability & Routing Controls" has working defaults and is optional.

# --- LLM provider credentials (fill in only what you use) ---
ZAI_API_KEY=your-zai-api-key

# External providers. Multiple numbered keys round-robin to spread rate limits.
CHUTES_BASE_URL=https://llm.chutes.ai
CHUTES_API_KEY1=your-chutes-api-key
# CHUTES_API_KEY2=
# CHUTES_API_KEY3=
# CHUTES_API_KEY4=

FEATHERLESS_BASE_URL=https://api.featherless.ai
FEATHERLESS_API_KEY1=your-featherless-api-key
# Add FEATHERLESS_API_KEY11..18 the same way if you hold multiple keys.

# OLLAMA_API_KEY=your-ollama-api-key
MINIMAX_API_KEY=your-minimax-api-key

# OpenRouter. Numbered keys round-robin; one is enough to start.
OPENROUTER_API_KEY1=your-openrouter-api-key
# OPENROUTER_API_KEY2=
# OPENROUTER_API_KEY3=

OLLAMA_API_KEY=your-ollama-api-key