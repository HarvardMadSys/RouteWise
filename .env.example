OPENAI_API_KEY=<YOUR_API_KEY_HERE>
OPENAI_BASE_URL=https://api.openai.com/v1

LLAMA_API_KEY=<YOUR_API_KEY_HERE>
LLAMA_BASE_URL=https://api.llama.com/compat/v1/

GEMINI_API_KEY=<YOUR_API_KEY_HERE>

DEEPSEEK_API_KEY=<YOUR_API_KEY_HERE>

# Local VLLM server (freeinference.org or your own deployment)
LOCAL_BASE_URL=http://freeinference.org/v1

OFFLOAD=

# Database (PostgreSQL)
# SECURITY: Set strong credentials before starting services
# Start with: docker compose -f infrastructure/docker/docker-compose.yml up -d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=<YOUR_DB_NAME>
DB_USER=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_SECURE_PASSWORD>
DB_ENABLED=true

# Observability
METRICS_ENABLED=1
# full|family — set to family to coarsen model labels
METRICS_MODEL_LABEL=full

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Routing health & circuit breaker
ROUTER_HEALTH_EWMA_ALPHA=0.2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MIN_AVAILABILITY=0.7

# API Key Authentication
# 0=disabled (all requests allowed, OpenRouter friendly)
# 1=enabled (API key required for all requests)
USER_AUTH_ENABLED=0

# For HMAC key hashing - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET=<CHANGE_ME_TO_RANDOM_64_CHAR_SECRET>

# Admin access for /admin/* endpoints
ADMIN_TOKEN=<CHANGE_ME_TO_RANDOM_ADMIN_TOKEN>

# Default quotas for new users
# Cost-based quota: $1000/day allows substantial usage while preventing runaway costs
USER_DEFAULT_DAILY_COST_USD=1000.00
USER_DEFAULT_MONTHLY_COST_USD=  # Optional: set monthly limit if needed
